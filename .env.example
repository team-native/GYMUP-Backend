# Copy to .env for local development. Change the secret before any shared deployment.
GYMUP_DATABASE_URL=postgresql+asyncpg://gymup:gymup@localhost:5432/gymup
GYMUP_JWT_SECRET=local-development-only-change-this-secret
GYMUP_JWT_ALGORITHM=HS256
GYMUP_API_PREFIX=/api/v1
GYMUP_ENVIRONMENT=development
GYMUP_PUBLIC_BASE_URL=http://localhost:8000
GYMUP_MEDIA_ROOT=./data/media
